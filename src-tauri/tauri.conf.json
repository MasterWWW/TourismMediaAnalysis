{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Travel Archive",
  "version": "0.1.0",
  "identifier": "io.github.masterwww.tourismmediaorganizer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "旅游照片 / 视频整理",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "按年月归档旅游照片和视频，并安全隔离重复项。",
    "longDescription": "本地优先的旅游媒体整理工具：扫描照片和视频，按拍摄年月生成归档计划，先预览再移动，保留隔离区与可回滚日志。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
